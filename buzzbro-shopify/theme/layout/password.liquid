<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    {%- liquid
      assign body_font = settings.type_body_font
      assign f700 = body_font | font_modify: 'weight', '700'
      assign f800i = body_font | font_modify: 'weight', '800' | font_modify: 'style', 'italic'
    -%}
    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ f700 | font_face: font_display: 'swap' }}
      {{ f800i | font_face: font_display: 'swap' }}
      :root {
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --color-navy: {{ settings.color_navy }};
        --color-ink: {{ settings.color_ink }};
        --color-mint: {{ settings.color_mint }};
        --color-sky: {{ settings.color_sky }};
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-password">
    <main id="MainContent">
      {{ content_for_layout }}
    </main>
  </body>
</html>
