<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_navy }}">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.tagged_with' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.page' | t: page: current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% render 'meta-tags' %}

    {%- liquid
      assign body_font = settings.type_body_font
      assign f500 = body_font | font_modify: 'weight', '500'
      assign f600 = body_font | font_modify: 'weight', '600'
      assign f700 = body_font | font_modify: 'weight', '700'
      assign f800i = body_font | font_modify: 'weight', '800' | font_modify: 'style', 'italic'
    -%}
    <style>
      {{ body_font | font_face: font_display: 'swap' }}
      {{ f500 | font_face: font_display: 'swap' }}
      {{ f600 | font_face: font_display: 'swap' }}
      {{ f700 | font_face: font_display: 'swap' }}
      {{ f800i | font_face: font_display: 'swap' }}

      :root {
        --font-body: {{ body_font.family }}, {{ body_font.fallback_families }};
        --color-navy: {{ settings.color_navy }};
        --color-ink: {{ settings.color_ink }};
        --color-badge: {{ settings.color_badge }};
        --color-lime: {{ settings.color_lime }};
        --color-mint: {{ settings.color_mint }};
        --color-sky: {{ settings.color_sky }};
        --color-ice: {{ settings.color_ice }};
        --color-alert: {{ settings.color_alert }};
        --color-star: {{ settings.color_star }};
      }
    </style>

    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}

    <script>document.documentElement.className = document.documentElement.className.replace('no-js', 'js');</script>
  </head>

  <body class="template-{{ template.name | handle }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix | handle }}{% endif %}">
    <a class="skip-link" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <div class="toast" data-toast role="status" aria-live="polite" hidden></div>

    <script>
      window.BuzzBro = {
        routes: {
          cart_add_url: '{{ routes.cart_add_url }}',
          cart_url: '{{ routes.cart_url }}',
          cart_js: '{{ routes.cart_url }}.js'
        },
        strings: {
          added: {{ 'cart.added_to_cart' | t | json }},
          error: {{ 'cart.add_error' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }}
        }
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
