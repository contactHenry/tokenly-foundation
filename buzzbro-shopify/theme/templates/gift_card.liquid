{%- layout none -%}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ 'gift_card.title' | t }} – {{ shop.name }}</title>
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body>
    <main class="password-page">
      <p class="password-page__word">{{ shop.name | upcase }}</p>
      <h1 class="page-title">{{ 'gift_card.title' | t }}</h1>
      <p style="font-size:32px;font-weight:700">{{ gift_card.balance | money }}</p>
      <p>{{ 'gift_card.code' | t }}: <strong>{{ gift_card.code | format_code }}</strong></p>
      {%- if gift_card.pass_url -%}<a href="{{ gift_card.pass_url }}"><img src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}" width="120" height="40" alt="Add to Apple Wallet"></a>{%- endif -%}
      <a class="btn btn--hero" href="{{ shop.url }}" style="width:auto;padding:0 40px">{{ 'cart.continue' | t }}</a>
    </main>
  </body>
</html>
