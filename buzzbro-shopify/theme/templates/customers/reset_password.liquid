<section class="page-width account">
  <h1 class="page-title">{{ 'customer.reset' | t }}</h1>
  {%- form 'reset_customer_password' -%}
    {{ form.errors | default_errors }}
    <div class="field field--sm"><label for="ResetPass">{{ 'customer.password' | t }}</label><input id="ResetPass" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <div class="field field--sm"><label for="ResetPass2">{{ 'customer.password' | t }}</label><input id="ResetPass2" type="password" name="customer[password_confirmation]" autocomplete="new-password" required></div>
    <button class="btn btn--primary" type="submit">{{ 'customer.reset' | t }}</button>
  {%- endform -%}
</section>
