<section class="page-width account">
  <p><a class="link-underline" href="{{ routes.account_url }}">← {{ 'customer.account' | t }}</a></p>
  <h1 class="page-title" style="margin-top:16px">{{ 'customer.addresses' | t }}</h1>
  {%- paginate customer.addresses by 10 -%}
    {%- for address in customer.addresses -%}
      <div style="margin-top:24px;padding:20px;border:1px solid var(--color-line);border-radius:12px">
        {{ address | format_address }}
        {%- if address == customer.default_address -%}<p style="margin-top:8px;font-weight:600">Default</p>{%- endif -%}
        <form method="post" action="{{ routes.account_addresses_url }}/{{ address.id }}" style="margin-top:12px">
          <input type="hidden" name="_method" value="delete">
          <button class="link-underline" type="submit" style="background:none;border:0;padding:0">{{ 'cart.remove' | t }}</button>
        </form>
      </div>
    {%- endfor -%}
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
  <h2 style="margin-top:40px;font-size:24px">+</h2>
  {%- form 'customer_address', customer.new_address -%}
    <div class="field field--sm"><label for="AddrFirst">{{ 'customer.first_name' | t }}</label><input id="AddrFirst" name="address[first_name]" value="{{ form.first_name }}" autocomplete="given-name"></div>
    <div class="field field--sm"><label for="AddrLast">{{ 'customer.last_name' | t }}</label><input id="AddrLast" name="address[last_name]" value="{{ form.last_name }}" autocomplete="family-name"></div>
    <div class="field field--sm"><label for="Addr1">Address</label><input id="Addr1" name="address[address1]" value="{{ form.address1 }}" autocomplete="address-line1"></div>
    <div class="field field--sm"><label for="Addr2">Apartment, suite, etc.</label><input id="Addr2" name="address[address2]" value="{{ form.address2 }}" autocomplete="address-line2"></div>
    <div class="field field--sm"><label for="AddrCity">City</label><input id="AddrCity" name="address[city]" value="{{ form.city }}" autocomplete="address-level2"></div>
    <div class="field field--sm"><label for="AddrCountry">Country/Region</label><select id="AddrCountry" name="address[country]">{{ all_country_option_tags }}</select></div>
    <div class="field field--sm"><label for="AddrProvince">State</label><input id="AddrProvince" name="address[province]" value="{{ form.province }}" autocomplete="address-level1"></div>
    <div class="field field--sm"><label for="AddrZip">Zip Code</label><input id="AddrZip" name="address[zip]" value="{{ form.zip }}" autocomplete="postal-code"></div>
    <div class="field field--sm"><label for="AddrPhone">Phone</label><input id="AddrPhone" type="tel" name="address[phone]" value="{{ form.phone }}" autocomplete="tel"></div>
    <label style="display:flex;gap:8px;align-items:center">{{ form.set_as_default_checkbox }} Set as default</label>
    <button class="btn btn--primary" type="submit">{{ 'customer.submit' | t }}</button>
  {%- endform -%}
</section>
