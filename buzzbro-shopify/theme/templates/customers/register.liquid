<section class="page-width account">
  <h1 class="page-title">{{ 'customer.register' | t }}</h1>
  {%- form 'create_customer' -%}
    {{ form.errors | default_errors }}
    <div class="field field--sm"><label for="RegFirst">{{ 'customer.first_name' | t }}</label><input id="RegFirst" type="text" name="customer[first_name]" autocomplete="given-name"></div>
    <div class="field field--sm"><label for="RegLast">{{ 'customer.last_name' | t }}</label><input id="RegLast" type="text" name="customer[last_name]" autocomplete="family-name"></div>
    <div class="field field--sm"><label for="RegEmail">{{ 'customer.email' | t }}</label><input id="RegEmail" type="email" name="customer[email]" autocomplete="email" required></div>
    <div class="field field--sm"><label for="RegPassword">{{ 'customer.password' | t }}</label><input id="RegPassword" type="password" name="customer[password]" autocomplete="new-password" required></div>
    <button class="btn btn--primary" type="submit">{{ 'customer.register' | t }}</button>
  {%- endform -%}
</section>
