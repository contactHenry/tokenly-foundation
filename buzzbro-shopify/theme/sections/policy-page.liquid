{%- comment -%}
  Shipping & Returns (Figma 125:8042) and Warranty (125:8191).
  "Group" blocks are the 48px headings with a 3px rule. "Item" blocks follow them:
  - Boxed: optional 32px bold title, 24/50 text, 1px divider (shipping page).
  - Running text: no divider, 32px bold title on a 50px line, a blank line above (warranty page).
{%- endcomment -%}
<section class="page-width cp" style="--cp-pb: {{ section.settings.padding_bottom }}px;">
  <h1 class="cp__title">{{ section.settings.heading | default: page.title | escape }}</h1>

  {%- for block in section.blocks -%}
    {%- if block.type == 'group' or forloop.first -%}
      {%- assign start = forloop.index0 -%}
      <div class="cp__group"{% if block.type == 'group' %} {{ block.shopify_attributes }}{% endif %}>
        {%- if block.type == 'group' -%}<h2 class="cp__group-title">{{ block.settings.title | escape }}</h2>{%- endif -%}
        {%- assign prev_flow = false -%}
        {%- for it in section.blocks offset: start -%}
          {%- if it.type == 'group' and forloop.index0 > 0 -%}{%- break -%}{%- endif -%}
          {%- if it.type == 'item' -%}
            {%- liquid
              assign cls = 'cp__item'
              if it.settings.style == 'flow'
                assign cls = cls | append: ' cp__item--flow'
                unless prev_flow
                  assign cls = cls | append: ' is-first'
                endunless
                if it.settings.tight
                  assign cls = cls | append: ' is-tight'
                endif
                assign prev_flow = true
              else
                assign prev_flow = false
              endif
            -%}
            <div class="{{ cls }}" {{ it.shopify_attributes }}>
              {%- if it.settings.title != blank and it.settings.inline_title -%}
                <div class="cp__body has-inline-title"><span class="cp__inline-title">{{ it.settings.title | escape }}</span> {{ it.settings.text }}</div>
              {%- else -%}
                {%- if it.settings.title != blank -%}<h3 class="cp__item-title">{{ it.settings.title | escape }}</h3>{%- endif -%}
                {%- if it.settings.text != blank -%}<div class="cp__body">{{ it.settings.text }}</div>{%- endif -%}
              {%- endif -%}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  {%- endfor -%}

  {%- if section.settings.show_page_content and page.content != blank -%}
    <div class="cp__group"><div class="cp__body">{{ page.content }}</div></div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Policy page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "checkbox", "id": "show_page_content", "label": "Also show the page's own content", "default": true },
    { "type": "number", "id": "padding_bottom", "label": "Space below (px)", "default": 141 }
  ],
  "blocks": [
    { "type": "group", "name": "Group heading", "settings": [{ "type": "text", "id": "title", "label": "Heading", "default": "Returns & Refunds" }] },
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "select", "id": "style", "label": "Style", "default": "boxed", "options": [{ "value": "boxed", "label": "Boxed (divider below)" }, { "value": "flow", "label": "Running text" }] },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "checkbox", "id": "inline_title", "label": "Title runs into the text", "default": false },
        { "type": "checkbox", "id": "tight", "label": "No blank line above (running text)", "default": false },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Policy page" }]
}
{% endschema %}
