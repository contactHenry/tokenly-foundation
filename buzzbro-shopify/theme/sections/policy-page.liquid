{%- comment -%} Shipping & Returns (125:8042) and Warranty (125:8191) pages: titled text blocks. {%- endcomment -%}
<section class="page-width page-head policy">
  <h1 class="page-title">{{ section.settings.heading | default: page.title | escape }}</h1>
  {%- if section.settings.intro != blank -%}
    <div class="page-intro">{{ section.settings.intro }}</div>
  {%- endif -%}
  <div style="margin-top: 40px">
    {%- for block in section.blocks -%}
      <div class="policy__block" {{ block.shopify_attributes }}>
        {%- if block.settings.title != blank -%}<h2>{{ block.settings.title | escape }}</h2>{%- endif -%}
        <div class="rte">{{ block.settings.text }}</div>
      </div>
    {%- endfor -%}
    {%- if section.settings.show_page_content and page.content != blank -%}
      <div class="policy__block rte">{{ page.content }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Policy page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "info": "Defaults to the page title." },
    { "type": "richtext", "id": "intro", "label": "Intro" },
    { "type": "checkbox", "id": "show_page_content", "label": "Also show the page's own content", "default": true }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Text block",
      "settings": [
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [{ "name": "Policy page" }]
}
{% endschema %}
