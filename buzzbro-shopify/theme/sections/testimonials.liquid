{%- comment -%} Testimonials bar + cards (Figma nodes 145:2006, 145:2010). First block is the large feature. {%- endcomment -%}
{%- assign reviews_link = section.settings.reviews_link | default: routes.all_products_collection_url -%}
<section>
  <div class="testimonials-bar">
    <div class="page-width section-bar">
      <h2>{{ section.settings.heading | escape }}</h2>
      <a href="{{ reviews_link }}">{{ section.settings.link_label | escape }}</a>
    </div>
  </div>

  <div class="page-width testimonials">
    <div class="testimonials__grid">
      {%- for block in section.blocks limit: 1 -%}
        <div class="t-feature__photo" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', alt: block.settings.author }}
          {%- elsif block.settings.default_image != blank -%}
            <img src="{{ block.settings.default_image | asset_url }}" alt="{{ block.settings.author | escape }}" width="231" height="492" loading="lazy">
          {%- endif -%}
        </div>
        <figure class="t-feature__quote" style="margin:0">
          <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
          <figcaption><cite>{{ block.settings.author | escape }}</cite></figcaption>
        </figure>
      {%- endfor -%}

      <div class="t-cards">
        {%- for block in section.blocks offset: 1 -%}
          <figure class="t-card" style="margin:0" {{ block.shopify_attributes }}>
            <div class="t-card__photo">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 320 | image_tag: loading: 'lazy', alt: block.settings.author }}
              {%- elsif block.settings.default_image != blank -%}
                <img src="{{ block.settings.default_image | asset_url }}" alt="{{ block.settings.author | escape }}" width="160" height="265" loading="lazy">
              {%- endif -%}
            </div>
            <div>
              <blockquote>“{{ block.settings.quote | escape }}”</blockquote>
              <figcaption><cite>{{ block.settings.author | escape }}</cite></figcaption>
            </div>
          </figure>
        {%- endfor -%}
      </div>
    </div>

    {%- if section.settings.button_label != blank -%}
      <div class="testimonials__more"><a class="btn btn--outline-hero" href="{{ reviews_link }}">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Testimonials" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "See all reviews" },
    { "type": "url", "id": "reviews_link", "label": "Reviews link" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "See More" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Photo" },
        { "type": "text", "id": "default_image", "label": "Bundled photo file", "info": "Used when no photo is chosen. Leave as is." },
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Every shave is just smooth, no hassle at all." },
        { "type": "text", "id": "author", "label": "Name", "default": "Amy Lieberman" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "default_image": "testimonial-1.png", "quote": "Every shave is just smooth, no hassle at all.", "author": "Amy Lieberman" } },
        { "type": "testimonial", "settings": { "default_image": "testimonial-2.png", "quote": "No more cuts and nicks—this shaver changed everything for me!", "author": "Solomon Ajah" } },
        { "type": "testimonial", "settings": { "default_image": "testimonial-3.png", "quote": "Finally, no more razor bumps. This is so much better.", "author": "Cookie Melusi" } },
        { "type": "testimonial", "settings": { "default_image": "testimonial-4.png", "quote": "Works perfectly, wet or dry. Seriously a game-changer.", "author": "Jake Strong" } }
      ]
    }
  ]
}
{% endschema %}
