<div class="password-page">
  <p class="password-page__word">{{ shop.name | upcase }}</p>
  <h1 class="page-title">{{ 'general.password_title' | t }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'storefront_password' -%}
    {{ form.errors | default_errors }}
    <label class="visually-hidden" for="Password">{{ 'general.password_label' | t }}</label>
    <input type="password" name="password" id="Password" autocomplete="current-password" placeholder="{{ 'general.password_label' | t }}">
    <button class="btn btn--hero" type="submit" style="width:auto;padding:0 40px">{{ 'general.password_submit' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{ "name": "Password" }
{% endschema %}
