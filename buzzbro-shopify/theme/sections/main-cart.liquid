<section class="page-width cart">
  <h1 class="page-title">{{ 'cart.title' | t }}</h1>
  {%- if cart.item_count > 0 -%}
    <form action="{{ routes.cart_url }}" method="post" id="CartForm">
      <table class="cart__table">
        <thead><tr><th>Product</th><th>{{ 'products.quantity' | t }}</th><th style="text-align:right">{{ 'cart.subtotal' | t }}</th></tr></thead>
        <tbody>
          {%- for item in cart.items -%}
            <tr>
              <td>
                <div class="cart-item">
                  {%- if item.image -%}
                    <a href="{{ item.url }}">{{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}</a>
                  {%- endif -%}
                  <div>
                    <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title | escape }}</a>
                    {%- unless item.product.has_only_default_variant -%}<p class="cart-item__meta">{{ item.variant.title | escape }}</p>{%- endunless -%}
                    {%- if item.selling_plan_allocation -%}<p class="cart-item__meta">{{ item.selling_plan_allocation.selling_plan.name | escape }}</p>{%- endif -%}
                    {%- for d in item.line_level_discount_allocations -%}<p class="cart-item__meta">{{ d.discount_application.title | escape }} (−{{ d.amount | money }})</p>{%- endfor -%}
                    <p class="cart-item__meta">{{ item.final_price | money }}</p>
                    <a class="cart__remove" href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
                  </div>
                </div>
              </td>
              <td>
                <div class="qty" data-qty>
                  <button type="button" data-qty-minus aria-label="−">−</button>
                  <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" aria-label="{{ 'products.quantity' | t }}" data-qty-input>
                  <button type="button" data-qty-plus aria-label="+">+</button>
                </div>
              </td>
              <td style="text-align:right; font-weight:600">{{ item.final_line_price | money }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>

      <div class="cart__footer">
        <div class="cart__note">
          {%- if section.settings.show_note -%}
            <label for="CartNote" style="display:block;margin-bottom:8px">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" name="note">{{ cart.note }}</textarea>
          {%- endif -%}
        </div>
        <div class="cart__totals">
          {%- for d in cart.cart_level_discount_applications -%}<p>{{ d.title | escape }} (−{{ d.total_allocated_amount | money }})</p>{%- endfor -%}
          <p class="cart__subtotal">{{ 'cart.subtotal' | t }}: {{ cart.total_price | money_with_currency }}</p>
          <p style="font-size:14px">{{ 'cart.taxes_note' | t }}</p>
          <button class="btn btn--ghost" type="submit" name="update" style="height:48px;width:100%">{{ 'cart.update' | t }}</button>
          <button class="btn btn--primary" type="submit" name="checkout">{{ 'cart.checkout' | t }}</button>
          {%- if additional_checkout_buttons -%}<div>{{ content_for_additional_checkout_buttons }}</div>{%- endif -%}
        </div>
      </div>
    </form>
  {%- else -%}
    <div class="cart-empty">
      <p style="font-size:20px">{{ 'cart.empty' | t }}</p>
      <a class="btn btn--hero" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [{ "type": "checkbox", "id": "show_note", "label": "Show order note", "default": false }]
}
{% endschema %}
