{%- comment -%}
  Product page top (Figma frames 157:2744 / 166:3528 / 170:4235): gallery with thumbnails,
  breadcrumb, title, description, price, rating, perks, buy button and delivery estimate.
  If the product has selling plans (a subscription app such as Shopify Subscriptions),
  the button reads "Subscribe Now | price" like the design.
{%- endcomment -%}
{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_plans = false
  if product.selling_plan_groups.size > 0
    assign has_plans = true
  endif
  assign default_plan = false
  if has_plans and section.settings.default_to_subscription
    assign default_plan = product.selling_plan_groups.first.selling_plans.first
  endif
  if product.requires_selling_plan and has_plans
    assign default_plan = product.selling_plan_groups.first.selling_plans.first
  endif
-%}

<section class="page-width pdp" data-product-section data-section-id="{{ section.id }}">
  <div class="pdp__grid">
    <div class="gallery" data-gallery>
      <div class="gallery__main">
        {%- for media in product.media -%}
          {%- liquid
            assign img = media.preview_image | default: media
            if forloop.first
              assign img_class = 'is-active'
              assign img_loading = 'eager'
            else
              assign img_class = ''
              assign img_loading = 'lazy'
            endif
          -%}
          {%- if img != blank -%}
            <div class="gallery__slide {{ img_class }}" data-media-id="{{ media.id }}">
              {{ img | image_url: width: 1400 | image_tag: loading: img_loading, widths: '600, 900, 1200, 1400', sizes: '(max-width: 900px) 100vw, 633px', alt: img.alt | default: product.title }}
            </div>
          {%- endif -%}
        {%- else -%}
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        {%- endfor -%}
      </div>
      {%- if product.media.size > 1 -%}
        <ul class="gallery__thumbs" role="list">
          {%- for media in product.media limit: 4 -%}
            {%- assign img = media.preview_image | default: media -%}
            <li>
              <button class="gallery__thumb" type="button" data-thumb="{{ media.id }}" aria-label="{{ img.alt | default: product.title | escape }}"{% if forloop.first %} aria-current="true"{% endif %}>
                {{ img | image_url: width: 260 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    <div class="pdp__info">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a>/<a href="{{ routes.all_products_collection_url }}">{{ 'general.shop_all' | t }}</a>/<span aria-current="page">{{ product.title | escape }}</span>
      </nav>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'title' -%}
            <h1 class="pdp__title" {{ block.shopify_attributes }}>{{ product.title | escape }}</h1>

          {%- when 'description' -%}
            {%- if product.description != blank -%}
              <div class="pdp__desc" {{ block.shopify_attributes }}>{{ product.description }}</div>
            {%- endif -%}

          {%- when 'price' -%}
            <div class="pdp__price" {{ block.shopify_attributes }} data-price-wrapper{% unless block.settings.show_compare %} data-hide-compare{% endunless %}>{%- liquid
              assign hide_cmp = true
              if block.settings.show_compare
                assign hide_cmp = false
              endif
            -%}{% render 'price', product: product, variant: current_variant, hide_compare: hide_cmp %}</div>

          {%- when 'rating' -%}
            <div class="pdp__rating-slot" {{ block.shopify_attributes }}>{% render 'rating', product: product %}</div>

          {%- when 'perks' -%}
            <div class="pdp__perks" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}<p class="pdp__perks-title">{{ block.settings.heading | escape }}</p>{%- endif -%}
              {%- assign perk_lines = block.settings.bullets | newline_to_br | split: '<br />' -%}
              <ul class="pdp__bullets">
                {%- for line in perk_lines -%}
                  {%- assign l = line | strip -%}
                  {%- if l != blank -%}<li>{{ l | escape }}</li>{%- endif -%}
                {%- endfor -%}
              </ul>
            </div>

          {%- when 'buy_buttons' -%}
            <div class="pdp__buy" {{ block.shopify_attributes }}>
              {%- capture gift_ids -%}{% render 'gift-ids', gift_product: product %}{%- endcapture -%}
              {%- form 'product', product, id: 'ProductForm-main', data-product-form: '', data-gift-ids: gift_ids, novalidate: 'novalidate' -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>

                {%- unless product.has_only_default_variant -%}
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker">
                      <legend>{{ option.name | escape }}</legend>
                      <div class="variant-picker__options">
                        {%- for value in option.values -%}
                          <input type="radio" id="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}" name="option{{ forloop.parentloop.index }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %} data-option-input>
                          <label for="opt-{{ section.id }}-{{ forloop.parentloop.index }}-{{ forloop.index }}">{{ value | escape }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                {%- endunless -%}

                {%- if has_plans -%}
                  <div class="purchase-options" data-purchase-options>
                    {%- unless product.requires_selling_plan -%}
                      <label class="purchase-option">
                        <input type="radio" name="purchase_type" value=""{% unless default_plan %} checked{% endunless %} data-plan-input>
                        {{ 'products.one_time' | t }}
                        <span class="purchase-option__price" data-plan-price="">{{ current_variant.price | money }}</span>
                      </label>
                    {%- endunless -%}
                    {%- for group in product.selling_plan_groups -%}
                      {%- for plan in group.selling_plans -%}
                        {%- assign allocation = current_variant.selling_plan_allocations | where: 'selling_plan.id', plan.id | first -%}
                        <label class="purchase-option">
                          <input type="radio" name="purchase_type" value="{{ plan.id }}"{% if default_plan and default_plan.id == plan.id %} checked{% endif %} data-plan-input>
                          {{ plan.name | escape }}
                          {%- if allocation -%}<span class="purchase-option__price" data-plan-price="{{ plan.id }}">{{ allocation.price | money }}</span>{%- endif -%}
                        </label>
                      {%- endfor -%}
                    {%- endfor -%}
                  </div>
                  <input type="hidden" name="selling_plan" value="{% if default_plan %}{{ default_plan.id }}{% endif %}" data-selling-plan>
                {%- endif -%}

                {%- liquid
                  assign button_price = current_variant.price
                  if default_plan
                    assign alloc = current_variant.selling_plan_allocations | where: 'selling_plan.id', default_plan.id | first
                    if alloc
                      assign button_price = alloc.price
                    endif
                  endif
                -%}
                <button
                  type="submit"
                  class="btn btn--buy"
                  data-add-button
                  data-label-subscribe="{{ block.settings.subscribe_label | escape }}"
                  data-label-buy="{{ block.settings.buy_label | escape }}"
                  {% unless current_variant.available %}disabled{% endunless %}
                >
                  {%- if current_variant.available -%}
                    <span data-add-label>{% if default_plan %}{{ block.settings.subscribe_label | escape }}{% else %}{{ block.settings.buy_label | escape }}{% endif %}</span>
                    <span class="sep" aria-hidden="true"></span>
                    <span data-add-price>{{ button_price | money }}</span>
                  {%- else -%}
                    {{ 'products.sold_out' | t }}
                  {%- endif -%}
                </button>

                {%- if block.settings.show_dynamic_checkout -%}
                  <div class="dynamic-checkout">{{ form | payment_button }}</div>
                {%- endif -%}
              {%- endform -%}

              {%- if block.settings.show_delivery -%}
                <p
                  class="delivery-estimate"
                  data-delivery-estimate
                  data-min-days="{{ block.settings.delivery_days }}"
                  data-cutoff-hour="{{ block.settings.cutoff_hour }}"
                  data-template="{{ 'products.delivery_estimate' | t | escape }}"
                  hidden
                ></p>
              {%- endif -%}
            </div>

          {%- when 'trust' -%}
            <div class="pdp__trust" {{ block.shopify_attributes }}>
              {%- if block.settings.text_1 != blank -%}<p class="trust-item">{% render 'icon', name: 'truck' %}<span>{{ block.settings.text_1 | escape }}</span></p>{%- endif -%}
              {%- if block.settings.text_2 != blank -%}<p class="trust-item">{% render 'icon', name: 'calendar' %}<span>{{ block.settings.text_2 | escape }}</span></p>{%- endif -%}
            </div>

          {%- when '@app' -%}
            {% render block %}
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>

  <script type="application/json" data-product-json>
    {
      "variants": [
        {%- for v in product.variants -%}
          {
            "id": {{ v.id }},
            "available": {{ v.available | json }},
            "options": {{ v.options | json }},
            "price": {{ v.price | money | json }},
            "compare_at_price": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
            "saving": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100.0 | divided_by: v.compare_at_price | round }}{% else %}null{% endif %},
            "media_id": {{ v.featured_media.id | default: 'null' }},
            "plans": {
              {%- for a in v.selling_plan_allocations -%}
                "{{ a.selling_plan.id }}": {{ a.price | money | json }}{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ],
      "badgeText": {{ settings.sale_badge_text | json }},
      "showBadge": {{ settings.show_sale_badge | json }},
      "soldOut": {{ 'products.sold_out' | t | json }}
    }
  </script>
</section>

{% schema %}
{
  "name": "Product information",
  "tag": "div",
  "blocks": [
    { "type": "@app" },
    { "type": "title", "name": "Title", "limit": 1 },
    { "type": "description", "name": "Description", "limit": 1 },
    { "type": "price", "name": "Price", "limit": 1, "settings": [{ "type": "checkbox", "id": "show_compare", "label": "Show compare-at price and Save badge", "default": false, "info": "Off matches the design: the product page shows the price alone." }] },
    { "type": "rating", "name": "Rating", "limit": 1 },
    {
      "type": "perks",
      "name": "Perks list",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Free Shipping & Lifetime Warranty!" },
        { "type": "textarea", "id": "bullets", "label": "Bullets (one per line)", "default": "Change or cancel anytime\nBlade Refills for $24.95 every 2 months\nBlades deliver up to 50 smooth shaves each" }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "subscribe_label", "label": "Label when a subscription is selected", "default": "Subscribe Now" },
        { "type": "text", "id": "buy_label", "label": "Label for one-time purchase", "default": "Add to cart" },
        { "type": "checkbox", "id": "show_dynamic_checkout", "label": "Show Shop Pay / PayPal express buttons", "default": false },
        { "type": "checkbox", "id": "show_delivery", "label": "Show estimated delivery", "default": true },
        { "type": "range", "id": "delivery_days", "label": "Business days to deliver", "min": 1, "max": 14, "step": 1, "default": 3 },
        { "type": "range", "id": "cutoff_hour", "label": "Same-day dispatch cutoff (shopper's local hour)", "min": 8, "max": 23, "step": 1, "default": 17 }
      ]
    },
    {
      "type": "trust",
      "name": "Trust badges",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "text_1", "label": "First badge", "default": "Free Shipping and Easy Returns 30-Day Trial & Guarantee Product Benefits" },
        { "type": "text", "id": "text_2", "label": "Second badge", "default": "Free Shipping and Easy Returns 30-Day Trial & Guarantee Product Benefits" }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "default_to_subscription", "label": "Pre-select subscription when available", "default": true }
  ]
}
{% endschema %}
