{%- comment -%} "When the Buzz gets you" call-to-action band (Figma node 145:2000). {%- endcomment -%}
{%- liquid
  assign link = section.settings.button_link
  if link == blank and section.settings.product != blank
    assign link = section.settings.product.url
  endif
  if link == blank
    assign link = routes.all_products_collection_url
  endif
-%}
<section class="buzz-cta">
  <div class="buzz-cta__stage">
    <h2 class="buzz-cta__heading">{{ section.settings.heading | escape }}</h2>
    <p class="buzz-cta__wordmark" aria-hidden="true">{{ section.settings.wordmark | escape }}</p>
    <div class="buzz-cta__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300, 600, 900', sizes: '323px', alt: section.settings.image.alt | default: '' }}
      {%- else -%}
        <img src="{{ 'hero-smoothshave.png' | asset_url }}" alt="BuzzBro SmoothShave 2.0" width="391" height="520" loading="lazy">
      {%- endif -%}
    </div>
    {%- if section.settings.button_label != blank -%}
      <div class="buzz-cta__btn"><a class="btn btn--hero" href="{{ link }}">{{ section.settings.button_label | escape }}</a></div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Buzz call-to-action",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "When the Buzz gets you" },
    { "type": "text", "id": "wordmark", "label": "Wordmark", "default": "BUZZBRO" },
    { "type": "image_picker", "id": "image", "label": "Product image" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Get the SmoothShave 2.0" },
    { "type": "product", "id": "product", "label": "Button product" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Buzz call-to-action" }]
}
{% endschema %}
