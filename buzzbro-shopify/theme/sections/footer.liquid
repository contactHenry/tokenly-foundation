{%- comment -%}
  Footer, compact layout. Hierarchy:
  1. Brand (logo, tagline, social)   2. Link columns (small caps headings, links)
  3. Newsletter (heading, note, field)   4. Legal bar (divider, policies, copyright)
{%- endcomment -%}
<footer class="site-footer">
  <div class="page-width">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__logo" href="{{ routes.root_url }}">{% render 'logo', variant: 'inverse', loading: 'lazy' %}</a>
        {%- if section.settings.tagline != blank -%}
          <p class="site-footer__tagline">{{ section.settings.tagline | escape }}</p>
        {%- endif -%}
        <ul class="social" role="list">
          {%- assign networks = 'facebook,instagram,x,youtube' | split: ',' -%}
          {%- assign links = settings.social_facebook_link | append: '|' | append: settings.social_instagram_link | append: '|' | append: settings.social_twitter_link | append: '|' | append: settings.social_youtube_link | split: '|' -%}
          {%- assign labels = 'Facebook,Instagram,X,YouTube' | split: ',' -%}
          {%- for network in networks -%}
            {%- assign href = links[forloop.index0] -%}
            <li>
              {%- if href != blank -%}
                <a href="{{ href }}" target="_blank" rel="noopener" aria-label="{{ 'accessibility.social' | t: network: labels[forloop.index0] }}">
                  {% render 'icon', name: network %}
                </a>
              {%- else -%}
                <span aria-hidden="true">{% render 'icon', name: network %}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </div>

      <nav class="site-footer__cols" aria-label="Footer">
        {%- for block in section.blocks -%}
          {%- assign col_menu = linklists[block.settings.menu] -%}
          <div class="footer-col" {{ block.shopify_attributes }}>
            <h2 class="footer-col__heading">{{ block.settings.heading | escape }}</h2>
            <ul role="list">
              {%- for link in col_menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </nav>

      <div class="site-footer__newsletter">
        {%- form 'customer', class: 'newsletter', id: 'FooterNewsletter' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <h2 class="newsletter__heading"><label for="FooterEmail">{{ section.settings.newsletter_heading | escape }}</label></h2>
          {%- if section.settings.newsletter_text != blank -%}
            <p class="newsletter__text">{{ section.settings.newsletter_text | escape }}</p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="newsletter__msg" role="status">{{ 'newsletter.success' | t }}</p>
          {%- endif -%}
          {%- if form.errors -%}
            <p class="newsletter__msg" role="alert">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
          {%- endif -%}
          <div class="newsletter__field">
            <input id="FooterEmail" type="email" name="contact[email]" autocomplete="email" required placeholder="{{ 'newsletter.placeholder' | t }}">
            <button type="submit" aria-label="{{ 'newsletter.submit' | t }}">{% render 'icon', name: 'arrow-right' %}</button>
          </div>
        {%- endform -%}
      </div>
    </div>

    <div class="site-footer__bottom">
      <ul class="site-footer__legal" role="list">
        {%- assign legal = linklists[section.settings.legal_menu] -%}
        {%- if legal.links.size > 0 -%}
          {%- for link in legal.links -%}<li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>{%- endfor -%}
        {%- else -%}
          {%- if shop.privacy_policy -%}<li><a href="{{ shop.privacy_policy.url }}">Privacy Policy</a></li>{%- endif -%}
          {%- if shop.terms_of_service -%}<li><a href="{{ shop.terms_of_service.url }}">Terms &amp; Conditions</a></li>{%- endif -%}
        {%- endif -%}
      </ul>
      <p class="site-footer__copy">&copy; {{ 'now' | date: '%Y' }} {{ shop.name | upcase }}. All rights reserved.</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "enabled_on": { "groups": ["footer"] },
  "max_blocks": 4,
  "settings": [
    { "type": "text", "id": "tagline", "label": "Tagline", "default": "The closest shave, the softest touch. Head shavers and blades made for a smooth, effortless shave." },
    { "type": "text", "id": "newsletter_heading", "label": "Newsletter heading", "default": "Newsletter Sign Up" },
    { "type": "text", "id": "newsletter_text", "label": "Newsletter note", "default": "Shaving tips, blade-refill reminders and first access to new drops." },
    { "type": "link_list", "id": "legal_menu", "label": "Legal menu", "info": "Defaults to your Privacy and Terms policies." }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu" }
      ]
    }
  ],
  "presets": [{ "name": "Footer" }]
}
{% endschema %}
