<section class="page-width collection">
  <h1 class="page-title">{{ 'search.title' | t }}</h1>
  <form class="search-form" action="{{ routes.search_url }}" method="get" role="search">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'search.placeholder' | t }}" aria-label="{{ 'search.placeholder' | t }}">
    <input type="hidden" name="type" value="product">
    <button class="btn btn--primary" type="submit">{{ 'search.title' | t }}</button>
  </form>
  {%- if search.performed -%}
    {%- paginate search.results by 12 -%}
      <p style="margin: 32px 0">{% if search.results_count > 0 %}{{ 'search.results' | t: count: search.results_count, terms: search.terms }}{% else %}{{ 'search.no_results' | t: terms: search.terms }}{% endif %}</p>
      <ul class="grid" role="list">
        {%- for item in search.results -%}
          {%- if item.object_type == 'product' -%}<li>{% render 'product-card', card_product: item %}</li>{%- endif -%}
        {%- endfor -%}
      </ul>
      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  {%- endif -%}
</section>

{% schema %}
{ "name": "Search results" }
{% endschema %}
