{%- paginate blog.articles by 9 -%}
<section class="page-width collection">
  <h1 class="page-title" style="margin-bottom: 40px">{{ blog.title | escape }}</h1>
  <ul class="grid" role="list">
    {%- for article in blog.articles -%}
      <li>
        <a class="card" href="{{ article.url }}">
          <span class="card__media">
            {%- if article.image -%}{{ article.image | image_url: width: 900 | image_tag: loading: 'lazy', alt: article.title }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
          </span>
          <span class="product-title-lg">{{ article.title | escape }}</span>
          <span class="card__subtitle">{{ article.published_at | date: format: 'date' }}</span>
        </a>
      </li>
    {%- endfor -%}
  </ul>
  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}

{% schema %}
{ "name": "Blog posts" }
{% endschema %}
