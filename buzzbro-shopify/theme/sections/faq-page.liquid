{%- comment -%} FAQ page (Figma node 125:7832). Add a "Category" block, then "Question" blocks under it. {%- endcomment -%}
<section class="page-width faq-page">
  <div class="faq-page__hero">
    <h1 class="faq-page__title">{{ section.settings.heading | escape }}</h1>
    {%- if section.settings.subheading != blank -%}<p class="faq-page__sub">{{ section.settings.subheading | escape }}</p>{%- endif -%}
  </div>

  {%- for block in section.blocks -%}
    {%- if block.type == 'category' or forloop.first -%}
      {%- assign start = forloop.index0 -%}
      <div class="faq-group"{% if block.type == 'category' %} {{ block.shopify_attributes }}{% endif %}>
        {%- if block.type == 'category' -%}
          <h2 class="faq-group__title">{{ block.settings.title | escape }}</h2>
        {%- endif -%}
        <div class="accordion">
          {%- for q in section.blocks offset: start -%}
            {%- if q.type == 'category' and forloop.index0 > 0 -%}{%- break -%}{%- endif -%}
            {%- if q.type == 'question' -%}
              <details {{ q.shopify_attributes }} open>
                <summary>{{ q.settings.question | escape }}{% render 'icon', name: 'chevron-down' %}</summary>
                <div class="accordion__body rte">{{ q.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
</section>

{% schema %}
{
  "name": "FAQ page",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "👋 Hi there! What do you need help with today?" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "We’re here to assist you—ask us anything" }
  ],
  "blocks": [
    { "type": "category", "name": "Category", "settings": [{ "type": "text", "id": "title", "label": "Title", "default": "General" }] },
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Can I call customer support over the phone?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Currently, we don’t have phone support, but we’re working on it!</p>" }
      ]
    }
  ],
  "presets": [{ "name": "FAQ page" }]
}
{% endschema %}
