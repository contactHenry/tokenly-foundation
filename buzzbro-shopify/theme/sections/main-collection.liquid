{%- paginate collection.products by section.settings.per_page -%}
<section class="page-width collection">
  <div class="collection__head">
    <div>
      <h1 class="page-title">{{ collection.title | escape }}</h1>
      {%- if collection.description != blank -%}<div class="collection__desc rte">{{ collection.description }}</div>{%- endif -%}
    </div>
    {%- if section.settings.show_sort -%}
      <form class="sort" data-sort-form>
        <label class="visually-hidden" for="SortBy">{{ 'collections.sort_by' | t }}</label>
        {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}
        <select id="SortBy" name="sort_by" data-sort-select>
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == current_sort %} selected{% endif %}>{{ option.name | escape }}</option>
          {%- endfor -%}
        </select>
      </form>
    {%- endif -%}
  </div>

  {%- if collection.products.size > 0 -%}
    <ul class="grid" role="list">
      {%- for p in collection.products -%}
        <li>{% render 'product-card', card_product: p %}</li>
      {%- endfor -%}
    </ul>
  {%- else -%}
    <p>{{ 'collections.empty' | t }}</p>
  {%- endif -%}

  {% render 'pagination', paginate: paginate %}
</section>
{%- endpaginate -%}

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 6, "max": 48, "step": 3, "default": 12 },
    { "type": "checkbox", "id": "show_sort", "label": "Show sorting", "default": true }
  ]
}
{% endschema %}
