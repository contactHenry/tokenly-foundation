  {%- when 'youtube' -%}
    <svg viewBox="0 0 40 40" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"><path d="M20 33.3c3 0 5.9-.3 8.6-.8 3.4-.7 5.1-1.1 6.5-3 1.6-1.9 1.6-4.4 1.6-9.5s0-7.6-1.6-9.5c-1.4-1.9-3.1-2.3-6.5-3-2.7-.5-5.6-.8-8.6-.8s-5.9.3-8.6.8c-3.4.7-5.1 1.1-6.5 3C3.3 12.4 3.3 15 3.3 20s0 7.6 1.6 9.5c1.4 1.9 3.1 2.3 6.5 3 2.7.5 5.6.8 8.6.8Z"/><path d="M26.6 20.5c-.2.9-1.4 1.5-3.7 2.8-2.2 1.3-3.4 2-4.3 1.7-.4-.1-.7-.3-1-.6-.6-.7-.6-2.1-.6-4.9s0-4.2.6-4.9c.3-.3.6-.5 1-.6.9-.3 2.1.4 4.3 1.7 2.3 1.3 3.5 1.9 3.7 2.8.1.3.1.7 0 1Z"/></svg>
  {%- when 'attachment' -%}
