{%- comment -%}
  Inline line icons matching the Figma set (pixelarticons plus/arrow, iconoir arrows,
  ant-design arrow, hugeicons social/utility). Usage: {% render 'icon', name: 'plus' %}
{%- endcomment -%}
{%- case name -%}
  {%- when 'plus' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M11 4h2v7h7v2h-7v7h-2v-7H4v-2h7V4z"/></svg>
  {%- when 'arrow-up' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V4M6 10l6-6 6 6"/></svg>
  {%- when 'arrow-pixel-up' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><path d="M11 22h2V6h2V4h-2V2h-2v2H9v2h2v16zM7 6h2v2H7V6zm0 2v2H5V8h2zm10-2h-2v2h2V6zm0 2v2h2V8h-2z"/></svg>
  {%- when 'arrow-big-right' -%}
