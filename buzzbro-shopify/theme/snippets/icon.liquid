  {%- when 'chevron-down' -%}
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m18 9-6 6-6-6"/></svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 18 18" aria-hidden="true" focusable="false" fill="currentColor"><path d="M9 1.2l2.3 4.9 5.3.7-3.9 3.7 1 5.3L9 13.2l-4.7 2.6 1-5.3-3.9-3.7 5.3-.7L9 1.2z"/></svg>
